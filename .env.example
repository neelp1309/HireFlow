# Copy to .env and populate locally. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# Gemini
GEMINI_API_KEY=replace_with_your_key
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval
TOP_K_RETRIEVAL=20
TOP_K_RERANK=10
FINAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.0

# Hybrid ranking weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.25
WEIGHT_REQUIRED_SKILLS=0.30
WEIGHT_EXPERIENCE=0.15
WEIGHT_ROLE=0.20
WEIGHT_PREFERRED=0.10

# Production API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# API_ACCESS_KEY=replace_with_a_random_secret
API_MAX_REQUEST_MB=25
MAX_CANDIDATES_PER_REQUEST=500
METRICS_ENABLED=true

# In-memory search cache (never persisted)
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_CACHE_MAX_ENTRIES=128

# Hosted-model resilience
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_SECONDS=1.0
